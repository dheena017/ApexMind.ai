# =============================================================================
# ApexMind.ai - Omnichannel AI Studio Environment Configuration
# =============================================================================

# 1. CORE AI ENGINES
# GEMINI_API_KEY: Required for Gemini AI script generation & neural voice synthesis.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. APPLICATION NETWORKING
# APP_URL: The URL where the frontend application is hosted.
APP_URL="http://127.0.0.1:5173"
PORT="8000"
HOST="127.0.0.1"
NODE_ENV="development"

# 3. SECURITY & AUTHENTICATION
# JWT_SECRET_KEY: Used to sign and verify creator session tokens.
JWT_SECRET_KEY="apexmind-studio-secret-key-2026"

# 4. GOOGLE & YOUTUBE OAUTH 2.0
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:5173 or postmessage
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_SECRET=""

# 5. META (INSTAGRAM REELS & FACEBOOK PAGES)
# Meta for Developers: https://developers.facebook.com/apps/
# Products needed: Facebook Login and Instagram Graph API. Instagram publishing
# requires a Business or Creator account linked to a Facebook Page.
META_APP_ID=""
VITE_META_APP_ID=""
META_APP_SECRET=""
# Add this exact URL as a valid OAuth redirect URI in the Meta app.
META_REDIRECT_URI="http://localhost:5173/channels"
META_AUTH_REDIRECT_URI="http://localhost:5173/login"

# 6. STOCK MEDIA PROVIDERS (Commercial Stock Imagery & Footage)
# Pexels: Free instant API key at https://www.pexels.com/api/
PEXELS_API_KEY=""

# Pixabay: Free instant API key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=""

# Unsplash: Free developer access key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 7. GOOGLE SEARCH API (Web Video Discovery)
# Programmable Search Engine: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CSE_ID=""

# 8. ROYALTY-FREE MUSIC
# Jamendo API Client ID (defaults to '56d30c95')
JAMENDO_CLIENT_ID="56d30c95"
