# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID / VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID
# Enables official Google Identity Services One-Tap and Sign-in with Google.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_SECRET=""

# Stock Media Library Live APIs (Unlocks 100,000,000+ commercial stock photos & videos)
# Pexels: Free instant API key at https://www.pexels.com/api/
PEXELS_API_KEY=""

# Pixabay: Free instant API key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=""

# Unsplash: Free developer access key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# Google Custom Search Engine (CSE) for Web Video Discovery:
# Create a search engine at https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CSE_ID=""
