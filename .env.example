# ApexMind environment configuration
# Copy to .env and replace placeholder values. Never commit .env or put secrets
# in VITE_ variables; VITE_ values are compiled into the public frontend bundle.

# Application and local development
NODE_ENV="development"
APP_URL="http://localhost:5173"
HOS[IP_ADDRESS]0.1"
PORT="8000"
FRONTEND_H[IP_ADDRESS]0.0.1"
FRONTEND_PORT="5173"
BACKEND_URL="[IP_ADDRESS].1:8000"
# Production frontend API base URL; leave empty for local Vite proxy usage.
VITE_API_URL=""
# Optional: set this to select a Python executable.
# PYTHON=""

# Authentication and session signing
# Replace this development-only value with a long, random secret in production.
JWT_SECRET_KEY="replace-with-a-long-random-secret"

# Gemini model options are discovered from Google; these optional values set preferences.
GEMINI_API_KEY=""
DEFAULT_SCRIPT_MODEL=""
DEFAULT_TTS_MODEL=""

# Google OAuth and Programmable Search
# Use the same Web OAuth client ID for backend verification and frontend sign-in.
GOOGLE_CLIENT_ID=""
# Backend-only OAuth client secret. Never prefix this with VITE_.
GOOGLE_CLIENT_SECRET=""
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CSE_ID=""

# Facebook Login and Pages
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:5173/social-accounts"
FACEBOOK_AUTH_REDIRECT_URI="http://localhost:5173/login"

# Instagram Login and publishing (separate app credentials)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:5173/social-accounts"
INSTAGRAM_AUTH_REDIRECT_URI="http://localhost:5173/login"

# Stock media providers
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# Royalty-free music
JAMENDO_CLIENT_ID="56d30c95"

# Optional local runner settings
BACKEND_RELOAD="true"
LOG_LEVEL="info"
AUTO_INSTALL_DEPS="false"
AUTO_INSTALL_FRONTEND="false"
OPEN_BROWSER="false"
# Optional overrides used only when the frontend runner starts the backend.
# BACKEND_HOST="127.0.0.1"
# BACKEND_PORT="8000"
# Optional persistent database path. Defaults to backend/data/apexmind.db.
# APEXMIND_DB_PATH=""
