# Dependencies & Build Artifacts
node_modules/
build/
scratch/
dist/
coverage/
.DS_Store
Thumbs.db
*.log
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
**/.pytest_cache/

# SQLite Databases & Journal/Lock Files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ApexMind Centralized Data Folder (backend/data)
# Ignore generated runtime media & databases, but keep folder structure tracked via .gitkeep
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/audio/*
!backend/data/audio/.gitkeep
backend/data/media/*
!backend/data/media/.gitkeep
backend/data/rendered_shorts/*
!backend/data/rendered_shorts/.gitkeep
backend/data/cache/*
!backend/data/cache/.gitkeep
